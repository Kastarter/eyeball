# Worker control plane
EYEBALL_VOICE_WORKER_TOKEN=replace-with-at-least-32-random-bytes
EYEBALL_EXECUTOR_URL=http://host.docker.internal:8787
# Must be an executor API key pinned to the same project and user as sessions.
EYEBALL_VOICE_WORKER_KEY=ey_replace_with_user_pinned_key
EYEBALL_VOICE_DATABASE_PATH=/var/lib/eyeball/voice-worker.sqlite3
EYEBALL_VOICE_PUBLIC_URL=https://voice-worker.example.com
EYEBALL_VOICE_MEDIA_MODE=pipecat
EYEBALL_VOICE_DRAIN_SECONDS=25

# Model and speech services
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# PSTN transport
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WebRTC transport
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
