{
  "name": "@eyeball/sdk",
  "version": "0.2.0",
  "description": "TypeScript client for Eyeball tool discovery, execution, and automation APIs.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyeball-ai/eyeball.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/eyeball-ai/eyeball#readme",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src test"
  },
  "dependencies": {
    "@eyeball/catalog": "workspace:*",
    "@eyeball/core": "workspace:*"
  }
}
