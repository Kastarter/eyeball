{
  "name": "@eyeball/catalog",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node scripts/generate-baseline.mjs",
    "check:generated": "node scripts/generate-baseline.mjs --check",
    "test": "node scripts/generate-baseline.mjs --check && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check scripts src test"
  },
  "dependencies": {
    "@eyeball/core": "workspace:*"
  }
}
