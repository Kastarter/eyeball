{
  "name": "@eyeball/catalog",
  "version": "0.2.0",
  "description": "Deterministic Eyeball toolkit manifests, auth metadata, and tool discovery.",
  "private": false,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyeball-ai/eyeball.git",
    "directory": "packages/catalog"
  },
  "homepage": "https://github.com/eyeball-ai/eyeball#readme",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node scripts/generate-baseline.mjs",
    "check:generated": "node scripts/generate-baseline.mjs --check",
    "test": "node scripts/generate-baseline.mjs --check && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check scripts src test"
  },
  "dependencies": {
    "@eyeball/core": "workspace:*"
  }
}
