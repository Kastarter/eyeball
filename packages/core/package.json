{
  "name": "@eyeball/core",
  "version": "0.3.0",
  "description": "Canonical contracts, schemas, credentials, and execution seams for Eyeball.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyeball-ai/eyeball.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/eyeball-ai/eyeball#readme",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src test"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "5.0.10",
    "@opentelemetry/api": "^1.9.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
