{
  "name": "eyeball",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "demo:anthropic": "node --import tsx apps/mcp-gateway/demo/anthropic.ts",
    "demo:mcp": "node --import tsx apps/mcp-gateway/demo/mcp.ts",
    "demo:restaurant": "node --import tsx apps/mcp-gateway/demo/restaurant.ts",
    "dev:stack": "pnpm --dir mocks --config.verify-deps-before-run=false build && node --import tsx scripts/dev-stack.ts",
    "docs:generate": "node --import tsx scripts/generate-docs.ts",
    "docs:check": "node --import tsx scripts/check-docs.ts",
    "docs:snippets": "node --import tsx scripts/check-docs-snippets.ts",
    "docs:typecheck": "tsc -p tsconfig.docs.json",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "eyeball-auth": "tsx scripts/eyeball-auth.ts",
    "test": "pnpm test:dev-stack && turbo run test --concurrency=1",
    "test:contract": "pnpm --filter @eyeball/executor test:contract",
    "test:dev-stack": "vitest run scripts/dev-stack.test.ts",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.112.1",
    "@biomejs/biome": "^2.1.2",
    "@eyeball/sdk": "workspace:*",
    "@hono/node-server": "^1.16.0",
    "@types/node": "^24.0.15",
    "ai": "7.0.30",
    "openai": "6.48.0",
    "tsx": "^4.20.3",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
